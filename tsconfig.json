{
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // JavaScript Support (CRITICAL FOR MIGRATION)
    "allowJs": false, // Allows JSX and TSX files to coexist safely

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Modules
    "resolveJsonModule": true, // Ensures local JSON imports are parsed correctly

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true, // Leave false until migration is complete
    "noEmit": true,

    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"] // Recommending this root-level key to target your source folder
}
